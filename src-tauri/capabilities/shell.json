{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "shell",
  "description": "Commands available to the bundled desktop interface.",
  "webviews": ["main"],
  "permissions": [
    "allow-get-settings",
    "allow-save-settings",
    "allow-browser-state",
    "allow-copy-workshop-url",
    "allow-take-workshop-preview",
    "allow-browser-action",
    "allow-navigate-workshop",
    "allow-set-browser-slot",
    "allow-inspect-item",
    "allow-list-downloads",
    "allow-workshop-is-collection",
    "allow-preview-workshop",
    "allow-queue-workshop-batch",
    "allow-list-batches",
    "allow-cancel-batch",
    "allow-retry-batch",
    "allow-content-states",
    "allow-scan-external",
    "allow-list-external-items",
    "allow-open-external-folder",
    "allow-queue-download",
    "allow-retry-download",
    "allow-cancel-download",
    "allow-remove-download",
    "allow-download-logs",
    "allow-download-prompt",
    "allow-authenticate-download",
    "allow-item-download-state",
    "allow-sync-downloaded-badges",
    "allow-open-download-folder",
    "allow-download-backends",
    "allow-open-backend-source",
    "core:menu:allow-new",
    "core:menu:allow-popup",
    "core:resources:allow-close",
    "dialog:allow-open"
  ]
}
